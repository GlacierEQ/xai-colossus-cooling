{
  "__inputs": [{"name": "DS_INFLUXDB", "label": "InfluxDB", "type": "datasource", "pluginId": "influxdb"}],
  "title": "xAI Colossus 2 — Facility Operations Twin",
  "description": "Real-time multi-panel operational dashboard for xAI SAI tech team presentation",
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["colossus", "xai", "apex"],
  "panels": [
    {
      "id": 1,
      "title": "⚡ PUE — Real-Time",
      "type": "stat",
      "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
      "targets": [{"datasource": "DS_INFLUXDB",
        "query": "from(bucket: \"colossus\") |> range(start: -5m) |> filter(fn: (r) => r.kpi_name == \"pue\") |> last()"}],
      "fieldConfig": {"defaults": {"thresholds": {"steps": [
        {"color": "green", "value": null}, {"color": "yellow", "value": 1.05}, {"color": "red", "value": 1.10}]},
        "unit": "none", "decimals": 3}}
    },
    {
      "id": 2,
      "title": "💧 WCI — Water Consumption Index (L/kWh)",
      "type": "stat",
      "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
      "targets": [{"datasource": "DS_INFLUXDB",
        "query": "from(bucket: \"colossus\") |> range(start: -5m) |> filter(fn: (r) => r.kpi_name == \"wci\") |> last()"}],
      "fieldConfig": {"defaults": {"thresholds": {"steps": [
        {"color": "green", "value": null}, {"color": "yellow", "value": 0.08}, {"color": "red", "value": 0.15}]},
        "unit": "none", "decimals": 3}}
    },
    {
      "id": 3,
      "title": "🌡️ Mean GPU Junction Temp (°C)",
      "type": "stat",
      "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
      "targets": [{"datasource": "DS_INFLUXDB",
        "query": "from(bucket: \"colossus\") |> range(start: -5m) |> filter(fn: (r) => r._measurement == \"colossus_gpu_thermal\" and r._field == \"mean_die_temp_c\") |> mean()"}],
      "fieldConfig": {"defaults": {"thresholds": {"steps": [
        {"color": "green", "value": null}, {"color": "yellow", "value": 78}, {"color": "red", "value": 83}]},
        "unit": "celsius"}}
    },
    {
      "id": 4,
      "title": "⚡ Active Power (MW) by Source",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [{"datasource": "DS_INFLUXDB",
        "query": "from(bucket: \"colossus\") |> range(start: -1h) |> filter(fn: (r) => r._measurement == \"colossus_power\" and r._field == \"mw_active\") |> aggregateWindow(every: 30s, fn: mean)"}],
      "fieldConfig": {"defaults": {"unit": "watt", "custom": {"lineWidth": 2}}}
    },
    {
      "id": 5,
      "title": "🌡️ GPU Thermal — Zone Heat Map",
      "type": "heatmap",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [{"datasource": "DS_INFLUXDB",
        "query": "from(bucket: \"colossus\") |> range(start: -30m) |> filter(fn: (r) => r._measurement == \"colossus_gpu_thermal\" and r._field == \"mean_die_temp_c\") |> group(columns: [\"zone_id\"])"}]
    },
    {
      "id": 6,
      "title": "💧 Water Sources — Volume & Autonomy",
      "type": "bargauge",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "targets": [{"datasource": "DS_INFLUXDB",
        "query": "from(bucket: \"colossus\") |> range(start: -5m) |> filter(fn: (r) => r._measurement == \"colossus_water_flow\" and r._field == \"level_pct\") |> last() |> group(columns: [\"source\"])"}],
      "fieldConfig": {"defaults": {"min": 0, "max": 100, "unit": "percent",
        "thresholds": {"steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 30}, {"color": "green", "value": 60}]}}}
    },
    {
      "id": 7,
      "title": "🚨 Active Alerts",
      "type": "alertlist",
      "gridPos": {"x": 0, "y": 16, "w": 8, "h": 6},
      "options": {"alertInstanceLabelFilter": "", "dashboardAlerts": true, "groupBy": ["severity"],
        "maxItems": 20, "sortOrder": 1, "stateFilter": {"firing": true, "pending": true}}
    },
    {
      "id": 8,
      "title": "🔋 UPS Strings — Autonomy (min)",
      "type": "gauge",
      "gridPos": {"x": 8, "y": 16, "w": 4, "h": 6},
      "targets": [{"datasource": "DS_INFLUXDB",
        "query": "from(bucket: \"colossus\") |> range(start: -5m) |> filter(fn: (r) => r._measurement == \"colossus_power\" and r._field == \"ups_autonomy_min\") |> last()"}],
      "fieldConfig": {"defaults": {"min": 0, "max": 20, "unit": "m",
        "thresholds": {"steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 10}, {"color": "green", "value": 15}]}}}
    },
    {
      "id": 9,
      "title": "🔬 GPU Throttle Events — Rolling 1hr",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 16, "w": 12, "h": 6},
      "targets": [{"datasource": "DS_INFLUXDB",
        "query": "from(bucket: \"colossus\") |> range(start: -1h) |> filter(fn: (r) => r._measurement == \"colossus_gpu_thermal\" and r._field == \"throttled_gpus\") |> aggregateWindow(every: 1m, fn: sum)"}],
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"lineWidth": 2, "fillOpacity": 20}}}
    },
    {
      "id": 10,
      "title": "📊 KPI Scorecard",
      "type": "table",
      "gridPos": {"x": 0, "y": 22, "w": 24, "h": 6},
      "targets": [{"datasource": "DS_INFLUXDB",
        "query": "from(bucket: \"colossus\") |> range(start: -5m) |> filter(fn: (r) => r._measurement == \"colossus_kpi\") |> last() |> group(columns: [\"kpi_name\"])"}],
      "options": {"sortBy": [{"displayName": "kpi_name"}]}
    }
  ],
  "alerting": {
    "rules": [
      {"name": "PUE > 1.06", "condition": "last() > 1.06", "severity": "critical",
       "measurement": "colossus_kpi", "kpi": "pue"},
      {"name": "GPU Tj > 84°C", "condition": "last() > 84", "severity": "critical",
       "measurement": "colossus_gpu_thermal", "field": "max_die_temp_c"},
      {"name": "Water Cistern < 25%", "condition": "last() < 25", "severity": "warning",
       "measurement": "colossus_water_flow", "field": "level_pct"},
      {"name": "UPS Autonomy < 10 min", "condition": "last() < 10", "severity": "critical",
       "measurement": "colossus_power", "field": "ups_autonomy_min"},
      {"name": "ATS Transfer > 100ms", "condition": "last() > 100", "severity": "warning",
       "measurement": "colossus_power", "field": "ats_transfer_ms"},
      {"name": "Turbine Trip", "condition": "count() > 0", "severity": "critical",
       "measurement": "colossus_power", "field": "turbine_trip_count"}
    ]
  }
}
