{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glaciereq.local/schemas/m2a/response-bundle.schema.json",
  "title": "M2A Response Bundle",
  "description": "Bundled response contract for relevance-filtered M2A and MCP-to-All routing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "message_id",
    "bundle_status"
  ],
  "properties": {
    "message_id": {
      "type": "string",
      "minLength": 1
    },
    "bundle_status": {
      "type": "string",
      "enum": ["complete", "partial", "failed"]
    },
    "selected_responders": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "relevance", "confidence"],
        "properties": {
          "node_id": { "type": "string" },
          "relevance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "proposed_action": { "type": "string" },
          "result": {
            "type": "object",
            "additionalProperties": true
          },
          "cost_class": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "latency_class": {
            "type": "string",
            "enum": ["fast", "normal", "slow"]
          }
        }
      }
    },
    "suppressed_responders": {
      "type": "integer",
      "minimum": 0
    },
    "bundle_strategy": {
      "type": "string",
      "enum": ["first", "rank_and_merge", "rank_only"]
    },
    "audit_event_id": {
      "type": "string"
    },
    "errors": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
