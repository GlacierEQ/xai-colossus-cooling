{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glaciereq.local/schemas/m2a/capability-registration.schema.json",
  "title": "M2A Capability Registration",
  "description": "Registration contract for nodes participating in M2A and MCP-to-All routing.",
  "type": "object",
  "additionalProperties": false,
  "required": ["node_id", "node_type", "capabilities", "domains", "accepts_broadcast"],
  "properties": {
    "node_id": { "type": "string", "minLength": 1 },
    "node_type": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true
    },
    "domains": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true
    },
    "priority": { "type": "integer", "minimum": 0, "maximum": 10 },
    "cost_class": { "type": "string", "enum": ["low", "medium", "high"] },
    "latency_class": { "type": "string", "enum": ["fast", "normal", "slow"] },
    "accepts_broadcast": { "type": "boolean" },
    "response_mode": { "type": "string", "enum": ["direct", "selective", "bundle_only"] },
    "pillar": { "type": "string" },
    "effectiveness_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "current_load": { "type": "number", "minimum": 0, "maximum": 1 },
    "status": { "type": "string", "enum": ["healthy", "degraded", "offline"] }
  }
}
